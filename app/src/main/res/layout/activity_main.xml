<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <!-- 1. VOTRE NOUVELLE TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/maToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:elevation="4dp"
        android:paddingBottom="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/titreCentre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/main_app_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="0dp"
                android:layout_marginBottom="0dp"
                android:layout_centerInParent="true" />
    </androidx.appcompat.widget.Toolbar>
    

    <!-- 2. Les En-têtes de colonnes (Pour simuler un tableau) -->
    <!-- On utilise un LinearLayout horizontal pour aligner les 3 titres -->
    <LinearLayout
        android:id="@+id/enTetes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/maToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Colonne 1 : Parents (35% de la largeur) -->
        <TextView
            android:id="@+id/TriParent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.35"
            android:text="@string/label_parents_copains"
            android:textSize="@dimen/text_size_large"
            android:fontFeatureSettings="smcp"
            style="?attr/textAppearanceLabelLarge" />

        <!-- Colonne 2 : Enfant (40% de la largeur) -->
        <TextView
            android:id="@+id/TriEnfant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.37"
            android:text="@string/label_enfant"
            android:textSize="@dimen/text_size_normal"
            android:fontFeatureSettings="smcp"
            style="?attr/textAppearanceLabelLarge" />

        <!-- Colonne 3 : Date (25% de la largeur) -->
        <TextView
            android:id="@+id/TriDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.28"
            android:text="@string/label_date"
            android:textSize="@dimen/text_size_normal"
            android:fontFeatureSettings="smcp"
            style="?attr/textAppearanceLabelLarge"
            android:gravity="end" /> <!-- Texte aligné à droite -->
    </LinearLayout>

    <!-- 3. Le RecyclerView (La liste dynamique) -->
    <!-- C'est ici que vos lignes d'enfants s'afficheront -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAnniversaires"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/enTetes"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false" />

    <!-- NOUVEAU : Conteneur vertical qui regroupe Filtres + Bouton Ajouter -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#E3F2FD"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/layoutManageSelection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical"
                android:gravity="end">

            <!-- Le compteur -->
            <TextView
                android:id="@+id/textTitreSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 élément sélectionné"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnAnnulerSelection"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Annuler"
                    android:layout_marginEnd="6dp"/>

            </LinearLayout>
            <!-- Les boutons alignés  -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical"
                android:gravity="end">

                <Button
                    android:id="@+id/btnSupprimerSelection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supprimer"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@android:color/holo_red_light"/>

                <Button
                    android:id="@+id/btnExporterSelection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exporter vers..."
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>


        <!-- A. La nouvelle ligne de filtres (Catégories) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <LinearLayout
                android:id="@+id/categoryFilterContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp">

                <!-- Ces boutons seront générés ou ajoutés ici -->
                <Button android:id="@+id/boutonGroupeCopains" android:text="👾👾👾" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" style="@style/Widget.Material3.Button.TonalButton"/>
                <Button android:id="@+id/boutonGroupeFamille" android:text="Famille" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" style="@style/Widget.Material3.Button.TonalButton"/>
                <Button android:id="@+id/boutonGroupeTravail" android:text="Travail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" style="@style/Widget.Material3.Button.TonalButton"/>
                <Button android:id="@+id/boutonGroupeAutre" android:text="Autre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" style="@style/Widget.Material3.Button.TonalButton"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- B. Ton bouton "Ajouter" existant (Déplacé ici) -->
        <LinearLayout
            android:id="@+id/boutonAjouterContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="2dp">
        <Button
            android:id="@+id/boutonAjouter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_button_add"
            android:layout_margin="0dp" /> <!-- On enlève le margin top car il est collé au filtre -->

    </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>