<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <!-- 1. VOTRE NOUVELLE TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/maToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/titreCentre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/main_app_title"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerInParent="true" />
    </androidx.appcompat.widget.Toolbar>


    <!-- 2. Les En-têtes de colonnes (Pour simuler un tableau) -->
    <!-- On utilise un LinearLayout horizontal pour aligner les 3 titres -->
    <LinearLayout
        android:id="@+id/enTetes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/maToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Colonne 1 : Enfant (40% de la largeur) -->
        <TextView
            android:id="@+id/TriEnfant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="@string/label_enfant"
            android:textSize="@dimen/text_size_large"
            android:fontFeatureSettings="smcp"
            style="?attr/textAppearanceLabelLarge" />

        <!-- Colonne 2 : Parents (40% de la largeur) -->
        <TextView
            android:id="@+id/TriParent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="@string/label_parents"
            android:textSize="@dimen/text_size_large"
            android:fontFeatureSettings="smcp"
            style="?attr/textAppearanceLabelLarge" />

        <!-- Colonne 3 : Date (20% de la largeur) -->
        <TextView
            android:id="@+id/TriDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:text="@string/label_date"
            android:textSize="@dimen/text_size_large"
            android:fontFeatureSettings="smcp"
            style="?attr/textAppearanceLabelLarge"
            android:gravity="end" /> <!-- Texte aligné à droite -->
    </LinearLayout>

    <!-- 3. Le RecyclerView (La liste dynamique) -->
    <!-- C'est ici que vos lignes d'enfants s'afficheront -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAnniversaires"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/enTetes"
        app:layout_constraintBottom_toTopOf="@id/boutonAjouter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- 4. Le Bouton d'action (En bas de l'écran) -->
    <Button
        android:id="@+id/boutonAjouter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_button_add"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>